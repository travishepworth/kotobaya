#!/usr/bin/env bash
# kby — review from the shell, keybindings and bar widgets, on top of `kotobaya daemon`.
#
# Actions are pure bash (a FIFO write, no Python on the keypress path). Streams wrap
# `kotobaya watch` and render through jq using widget files in
# ${XDG_CONFIG_HOME:-~/.config}/kotobaya/widgets/NAME.conf. Run `kby help` for usage.
set -euo pipefail

# Bars and widgets are often started with a PATH that lacks ~/.local/bin: look there too.
export PATH="$PATH:$HOME/.local/bin"
KBY_CLI=${KBY_CLI:-kotobaya}
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/kotobaya-$(id -u)}/kotobaya"
FIFO="$RUNTIME_DIR/in"
SOCK="$RUNTIME_DIR/sock"
CACHE="$RUNTIME_DIR/state.json" # last state seen by any `kby stream`; read by `next` and `click`
WIDGET_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kotobaya/widgets"

DAEMON_ACTIONS=" reveal again hard good easy nothing something okay undo skip refresh keep_going stop_keep_going "
FIELDS="state conn new learning review total due pending day_ends_at notice last_rating undoable
card_id kind kind_label kind_badge kind_prefix front back reading sentence revealed preview_again preview_hard preview_good
preview_easy next_due_at next_due_in can_keep_going keep_hint"

die() { printf 'kby: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
kby — drive the kotobaya review daemon from keybindings and widgets

ACTIONS (instant; written to the daemon FIFO, several run in order)
  kby -r | reveal        show the back            kby -u | undo       undo last answer
  kby -1 | again         kby -2 | hard            kby -s | skip       move card to the back
  kby -3 | good          kby -4 | easy            kby -R | refresh    refetch the queue
  kby -n | next          reveal if hidden, else good (needs a running `kby stream`)
  kby -k | keep          KEEP GOING: study past today's limits (when done, done for now, or waiting for
                         a learning card; alias keep_going). Learning cards still wait for their time.
  kby -K | unkeep        stop keep going (back to today's limits; alias stop_keep_going)
  five-button names also work: nothing, something, okay
  kby do ACTION [--rev REV]       one action for GUI widgets: reveal again hard good easy undo skip
                                  refresh next keep_going stop_keep_going. Exit 2 (stderr only) if unknown or not enabled in
                                  the current state. With --rev a stale click is dropped (exit 0)
                                  and the next `serve` line says "Ignored: screen changed".

STREAM (long-lived, one waybar-style JSON line per state change)
  kby                             same as `kby -f`
  kby -f [WIDGET]                 {"text","tooltip","class","alt","state","buttons"} per line
                                  (rendered from WIDGET; default: built-in)
  kby -f [WIDGET] --text          just the text, one plain line per state
  kby stream --raw                the daemon's state JSON, unchanged
  kby stream --jq 'FILTER'        the daemon's state piped through your own jq filter

SERVE (machine interface for GUI widgets; data only, no widget confs)
  kby serve                       one compact JSON line per state change, flushed at once, forever.
                                  Offline / auth / error never end it: they are lines too.
  line (v 1): {"v":1, "state":"loading|front|back|waiting|done|offline|auth|error",
               "rev":"<card_id>:<n>" (changes every line; send it back as `kby do ... --rev`),
               "text":"語 12", "counts":{"new","learning","review"},
               "card":null|{"id","kind","kind_label" (Kanji/Vocab/..),"front"; "reading","sentence","back" only when revealed},
               "last":{"rating":null|"good"..,"undoable":bool}, "notice":null|"..." (one line only),
               "keep_going":bool, "more_available":bool, "can_keep_going":bool,
               "next_due_at":null|"<UTC ISO>" and "next_due_in":null|"m:ss" (state waiting: nothing due now,
               a learning card falls due then; fixed when the line was written), "error":null|"...",
               "actions":{"reveal","again","hard","good","easy","undo","skip","refresh","next","keep_going","stop_keep_going":
                          {"enabled":bool, "hint":"1m" (grades; only when known)}}}
  Each line is also written to $XDG_RUNTIME_DIR/kotobaya/state.json (temp file + rename).

WIDGETS (${XDG_CONFIG_HOME:-~/.config}/kotobaya/widgets/NAME.conf)
  kby click WIDGET BUTTON         run the action WIDGET binds to BUTTON in the current state
  kby widget new NAME             write a commented starter widget
  kby widget list | path NAME | show NAME
  kby fields                      template fields

OTHER
  kby status                      current state JSON (cache, else asks the daemon)
  kby state                       current state name: front back waiting done loading offline auth
EOF
}

# ---------------------------------------------------------------- state

# Echo the current state JSON: the stream cache if present, else one status request.
current_state_json() {
  if [[ -s $CACHE ]]; then
    cat -- "$CACHE"
  elif [[ -S $SOCK ]]; then
    python3 -I - "$SOCK" <<'PY' 2>/dev/null || true
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(2)
s.connect(sys.argv[1])
s.sendall(b'{"cmd":"status"}\n')
print(s.makefile("r").readline().strip())
PY
  fi
}

# Map a state JSON line to its state name. Pure bash: a structural "revealed":true can't
# occur inside card text, where quotes are escaped.
state_name() {
  local s=$1
  # A `kby serve` line (also written to the cache) names its state itself.
  if [[ $s =~ ^\{\"v\":1,\"state\":\"([a-z]+)\" ]]; then
    echo "${BASH_REMATCH[1]}"
    return
  fi
  if [[ -z $s || $s != *'"conn":"ok"'* ]]; then
    if [[ $s == *'"conn":"auth"'* ]]; then echo auth; else echo offline; fi
  elif [[ $s == *'"card":null'* ]]; then
    if [[ $s == *'"counts":null'* ]]; then
      echo loading
    elif [[ $s == *'"next_due_at":"'* ]]; then
      echo waiting
    else
      echo 'done'
    fi
  elif [[ $s == *'"revealed":true'* ]]; then
    echo back
  else
    echo front
  fi
}

# ---------------------------------------------------------------- actions

# Resolve words to daemon commands and write them to the FIFO in one atomic write.
send() {
  local word state=${KBY_STATE:-} out=()
  for word in "$@"; do
    word=${word,,}
    if [[ $word == next ]]; then
      [[ -n $state ]] || state=$(state_name "$(current_state_json)")
      case $state in
        front) word=reveal ;;
        back) word=good ;;
        *) continue ;;
      esac
    elif [[ $word == none || -z $word ]]; then
      continue
    elif [[ $DAEMON_ACTIONS != *" $word "* ]]; then
      die "unknown action '$word' (try: kby help)"
    fi
    out+=("$word")
  done
  ((${#out[@]})) || return 0
  # 1<> never blocks, but on a missing path it would create a regular file: check first.
  [[ -p $FIFO ]] || die "daemon not running (no FIFO at $FIFO)"
  printf '%s\n' "${out[@]}" 1<>"$FIFO"
}

# ---------------------------------------------------------------- do

DO_ACTIONS=" reveal again hard good easy undo skip refresh next keep_going stop_keep_going "
NOTICE_FILE="$RUNTIME_DIR/kby-notice" # one-shot note for the next `serve` line
STALE_NOTICE="Ignored: screen changed"

fail2() { printf 'kby: %s\n' "$*" >&2; exit 2; }

# The rev of a state line: serve lines carry one; a raw daemon state only has the card id, so
# its rev is "<card_id>:" (compared by card id alone).
state_rev() {
  local s=$1
  if [[ $s =~ ^\{\"v\":1,\"state\":\"[a-z]+\",\"rev\":\"([^\"]*)\" ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  elif [[ $s =~ \"card\":\{\"id\":\"([^\"]*)\" ]]; then
    printf '%s:' "${BASH_REMATCH[1]}"
  elif [[ -n $s ]]; then
    printf -- '-:'
  fi
}

# Is ACTION enabled in STATE (UNDOABLE: true|false)? Same table as `serve`'s "actions".
action_enabled() {
  local state=$1 undoable=$2 action=$3 json=${4:-}
  case $action in
    refresh) return 0 ;;
    keep_going) [[ $json == *'"can_keep_going":true'* ]] ;;
    stop_keep_going) [[ $json == *'"keep_going":true'* ]] ;;
    reveal) [[ $state == front ]] ;;
    again | hard | good | easy) [[ $state == back ]] ;;
    skip | next) [[ $state == front || $state == back ]] ;;
    undo) [[ $undoable == true ]] ;;
    *) return 1 ;;
  esac
}

do_action() {
  local action="" rev="" have_rev=0
  while (($#)); do
    case $1 in
      --rev) (($# >= 2)) || fail2 "--rev needs a value"; rev=$2 have_rev=1; shift ;;
      --rev=*) rev=${1#--rev=} have_rev=1 ;;
      -*) fail2 "unknown option $1 (usage: kby do ACTION [--rev REV])" ;;
      *) [[ -z $action ]] || fail2 "usage: kby do ACTION [--rev REV]"; action=${1,,} ;;
    esac
    shift
  done
  [[ -n $action ]] || fail2 "usage: kby do ACTION [--rev REV]"
  [[ $DO_ACTIONS == *" $action "* ]] ||
    fail2 "unknown action '$action' (one of:${DO_ACTIONS% })"

  local s state undoable=false cur
  s=$(current_state_json)
  if ((have_rev)); then
    cur=$(state_rev "$s")
    # Stale click: drop it, and have the daemon emit a line that carries the notice.
    if [[ -z $cur || ${rev%:*} != "${cur%:*}" || (${cur: -1} != : && $rev != "$cur") ]]; then
      mkdir -p -- "$RUNTIME_DIR"
      printf '%s' "$STALE_NOTICE" >"$NOTICE_FILE.$BASHPID" &&
        mv -f -- "$NOTICE_FILE.$BASHPID" "$NOTICE_FILE"
      (send refresh) 2>/dev/null || true
      return 0
    fi
  fi
  state=$(state_name "$s")
  [[ $s == *'"undoable":true'* ]] && undoable=true
  action_enabled "$state" "$undoable" "$action" "$s" ||
    fail2 "'$action' is not available while the card is: $state"
  KBY_STATE=$state send "$action"
}

# ---------------------------------------------------------------- serve

# jq program: one daemon state (or null) -> one serve line. Answer-side fields only when revealed.
# shellcheck disable=SC2016 # jq source, not shell
JQ_SERVE='
def nz: if . == "" then null else . end;
def statename($s):
  if $s == null then "loading"
  elif $s.conn != "ok" then (if $s.conn == "auth" then "auth" else "offline" end)
  elif $s.card != null then (if $s.card.revealed then "back" else "front" end)
  elif $s.counts == null then "loading"
  elif ($s.next_due_at // null) != null then "waiting" else "done" end;
def mss($s): ($s | floor) as $t | "\($t / 60 | floor):\(($t % 60) | tostring | if length < 2 then "0" + . else . end)";
def nextin($at): if $at == null or $at == "" then null
  else (try (($at | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) - now | if . < 0 then 0 else . end | mss(.)) catch null) end;
def nonull: with_entries(select(.value != null));
def one($t; $n): ($t | gsub("\\s*\n\\s*"; " ")) as $v
  | if ($v | length) > $n then $v[0:($n - 1)] + "…" else $v end;
def act($on; $h): {enabled: $on} + (if $h == null then {} else {hint: $h} end);
($force | nz) as $force | ($err | nz) as $err | ($notice | nz) as $notice
| $raw as $s
| ($force // statename($s)) as $st
| (if $s == null then null else $s.card end) as $k
| (($s.counts // null) // {new: 0, learning: 0, review: 0}) as $c
| ($c.new + $c.learning + $c.review) as $due
| ($k.revealed // false) as $rev
| (($s.last.undoable // false) and ($st == "front" or $st == "back" or $st == "done" or $st == "waiting")) as $undo
| ($k.previews // {}) as $p
| ($st == "front" or $st == "back") as $card
| {v: 1, state: $st,
   rev: "\($k.id // "-"):\($n)",
   text: (if $card then "\(one($k.front // "語"; 24)) \($due)"
          elif $st == "waiting" then "語 \(nextin($s.next_due_at) // "…")"
          elif $st == "done" then "語 ✓"
          elif $st == "loading" then "語 …"
          else "語 \($st)" end),
   counts: {new: $c.new, learning: $c.learning, review: $c.review},
   card: (if $k == null then null
          else ({id: $k.id, kind: $k.kind, kind_label: $k.kind_label, front: $k.front}
                + (if $rev then {reading: $k.reading, sentence: $k.sentence, back: $k.back} else {} end))
               | nonull end),
   last: {rating: ($s.last.rating // null), undoable: $undo},
   keep_going: ($s.keep_going // false),
   more_available: ($s.more_available // false),
   can_keep_going: ($s.can_keep_going // false),
   next_due_at: (if $st == "waiting" then $s.next_due_at else null end),
   next_due_in: (if $st == "waiting" then nextin($s.next_due_at) else null end),
   notice: ([$notice, $s.notice] | map(select(. != null and . != "")) | join("; ") | nz),
   error: ($err // (if $st == "offline" then "daemon not reachable (systemctl --user status kotobaya)"
                    elif $st == "auth" then "token rejected: the PAT needs scopes read and review"
                    else null end)),
   actions: {
     reveal: act($st == "front"; null),
     again: act($st == "back"; $p.again), hard: act($st == "back"; $p.hard),
     good: act($st == "back"; $p.good), easy: act($st == "back"; $p.easy),
     undo: act($undo; null), skip: act($card; null), refresh: act(true; null),
     next: act($card; null),
     keep_going: act(($st == "done" or $st == "waiting") and ($s.can_keep_going // false); null),
     stop_keep_going: act($s.keep_going // false; null)}}
'

SERVE_WPID="" SERVE_N=0 SERVE_ERRF=""

serve_cleanup() {
  [[ -z $SERVE_WPID ]] || kill "$SERVE_WPID" 2>/dev/null || true
  rm -f -- "$CACHE" "$SERVE_ERRF" 2>/dev/null || true
}

# serve_emit RAW_JSON|null [FORCE_STATE [ERROR]]: print, flush and cache one line.
serve_emit() {
  local raw=$1 force=${2:-} err=${3:-} notice="" line tmp="$CACHE.serve.$BASHPID"
  SERVE_N=$((SERVE_N + 1))
  if [[ -f $NOTICE_FILE ]] && mv -f -- "$NOTICE_FILE" "$NOTICE_FILE.$BASHPID" 2>/dev/null; then
    notice=$(<"$NOTICE_FILE.$BASHPID")
    rm -f -- "$NOTICE_FILE.$BASHPID"
  fi
  line=$(jq -nc --argjson raw "$raw" --argjson n "$SERVE_N" \
    --arg force "$force" --arg err "$err" --arg notice "$notice" "$JQ_SERVE" 2>/dev/null) ||
    line=$(jq -nc --argjson n "$SERVE_N" --arg err "${err:-state could not be rendered}" \
      '{v:1,state:"error",rev:"-:\($n)",text:"語 error",counts:{new:0,learning:0,review:0},card:null,
        last:{rating:null,undoable:false},notice:null,error:$err,
        actions:{reveal:{enabled:false},again:{enabled:false},hard:{enabled:false},
                 good:{enabled:false},easy:{enabled:false},undo:{enabled:false},
                 skip:{enabled:false},refresh:{enabled:true},next:{enabled:false},
                 keep_going:{enabled:false},stop_keep_going:{enabled:false}}}')
  # Cache first: whoever reacts to a printed line (`kby do --rev`) finds the same line there.
  printf '%s\n' "$line" >"$tmp" && mv -f -- "$tmp" "$CACHE"
  printf '%s\n' "$line"
}

serve() {
  command -v jq >/dev/null || die "jq not found"
  # shellcheck disable=SC2174 # only the runtime dir itself needs the mode
  mkdir -p -m 700 -- "$RUNTIME_DIR"
  rm -f -- "$NOTICE_FILE"
  SERVE_ERRF="$RUNTIME_DIR/.kby-serve-err.$BASHPID"
  trap serve_cleanup EXIT
  trap 'exit 0' TERM INT HUP PIPE

  serve_emit null
  local backoff=1 fd line rc err
  while :; do
    if command -v "$KBY_CLI" >/dev/null; then
      exec {fd}< <(exec "$KBY_CLI" watch --format json 2>"$SERVE_ERRF")
      SERVE_WPID=$!
      while IFS= read -r -u "$fd" line; do
        [[ -n $line ]] || continue
        backoff=1
        serve_emit "$line"
      done
      exec {fd}<&-
      rc=0
      wait "$SERVE_WPID" 2>/dev/null || rc=$?
      SERVE_WPID=""
      err=$(tail -n 1 -- "$SERVE_ERRF" 2>/dev/null || true)
      err="kotobaya watch exited (status $rc)${err:+: $err}"
    else
      err="'$KBY_CLI' not found (set KBY_CLI)"
    fi
    serve_emit null error "$err"
    sleep "$backoff" &
    wait $! || true
    backoff=$((backoff < 10 ? backoff * 2 : 10))
  done
}

# ---------------------------------------------------------------- widgets

widget_file() {
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "widget names use letters, digits, - and _ only"
  printf '%s/%s.conf' "$WIDGET_DIR" "$1"
}

default_widget() {
  cat <<'EOF'
# kotobaya widget. key = value; '#' starts a comment line.
#
# States: front (card hidden), back (revealed), waiting (nothing due now, a learning card falls due
# at {next_due_at}; {next_due_in} is m:ss), done (nothing left), loading, offline, auth.
# Fields unknown to an older config read as empty; {next_due_in} is fixed when the line is written.
#
# text[.STATE]     the line shown. text.STATE wins over text.
# tooltip[.STATE]  hover text (--json only).
# class[.STATE]    CSS class (--json only). Default: {state}.
# Templates: {field} or {field:N} (cut to N chars with …). `kby fields` lists the fields.
text         = 語 {new}/{learning}/{review}
text.front   = 語 {new}/{learning}/{review}  {kind_badge}{front:30}
text.back    = 語 {front:20} 【{reading:15}】 {back:40}
text.waiting = 語 next in {next_due_in}
text.done    = 語 ✓
text.loading = 語 …
text.offline = 語 offline
text.auth    = 語 token rejected
tooltip      = {kind_prefix}new {new} · learning {learning} · review {review} · pending {pending}  {notice}{keep_hint}
tooltip.offline = daemon not reachable (systemctl --user status kotobaya)
tooltip.auth = token rejected: the PAT needs scopes read and review
tooltip.back = {kind_prefix}again {preview_again} · hard {preview_hard} · good {preview_good} · easy {preview_easy}

# button.NAME[.STATE] = ACTION...  (NAME is anything your bar sends to `kby click`)
# ACTION: reveal again hard good easy undo skip refresh next keep_going stop_keep_going none (several: space-separated),
# or `!command` to run a shell command instead.
button.left             = next
button.right            = undo
button.middle           = skip
button.left.done        = keep_going
button.left.waiting     = keep_going
button.scroll-up.back   = good
button.scroll-down.back = again
button.1.back           = again
button.2.back           = hard
button.3.back           = good
button.4.back           = easy
EOF
}

# Echo the widget config for NAME (empty NAME = built-in default).
widget_conf() {
  if [[ -z ${1:-} ]]; then
    default_widget
  else
    local f
    f=$(widget_file "$1")
    [[ -r $f ]] || die "no widget '$1' ($f); create it with: kby widget new $1"
    cat -- "$f"
  fi
}

# Look up KEY in a config on stdin (pure bash; used on the click path).
conf_get() {
  local key=$1 line k v
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line == *=* ]] || continue
    k=${line%%=*} v=${line#*=}
    k=${k//[[:space:]]/}
    v=${v#"${v%%[![:space:]]*}"} v=${v%"${v##*[![:space:]]}"}
    if [[ $k == "$key" ]]; then printf '%s' "$v"; return 0; fi
  done
  return 1
}

click() {
  (($# == 2)) || die "usage: kby click WIDGET BUTTON"
  local conf state action
  conf=$(widget_conf "$1")
  state=$(state_name "$(current_state_json)")
  action=$(conf_get "button.$2.$state" <<<"$conf") ||
    action=$(conf_get "button.$2" <<<"$conf") || return 0
  if [[ $action == '!'* ]]; then
    KBY_STATE=$state exec sh -c "${action#!}"
  fi
  # keep_going only when the daemon says there is more (a stray click must not start it).
  if [[ $action == *keep_going* && $action != *stop_keep_going* ]] &&
    [[ $(current_state_json) != *'"can_keep_going":true'* ]]; then
    return 0
  fi
  # shellcheck disable=SC2086 # split the action list on spaces
  KBY_STATE=$state send $action
}

widget_cmd() {
  local sub=${1:-list}
  shift || true
  case $sub in
    list)
      [[ -d $WIDGET_DIR ]] || return 0
      local f
      for f in "$WIDGET_DIR"/*.conf; do [[ -e $f ]] && basename -- "$f" .conf; done
      ;;
    path) widget_file "${1:?usage: kby widget path NAME}"; echo ;;
    show) widget_conf "${1:?usage: kby widget show NAME}" ;;
    new)
      local f
      f=$(widget_file "${1:?usage: kby widget new NAME}")
      [[ -e $f ]] && die "$f already exists"
      mkdir -p -- "$WIDGET_DIR"
      default_widget >"$f"
      echo "$f"
      ;;
    *) die "unknown: kby widget $sub" ;;
  esac
}

# ---------------------------------------------------------------- streams

# jq program: flatten a daemon state, pick per-state templates, fill them.
# shellcheck disable=SC2016 # jq source, not shell
JQ_RENDER='
def mss($s): ($s | floor) as $t | "\($t / 60 | floor):\(($t % 60) | tostring | if length < 2 then "0" + . else . end)";
def nextin($at): if $at == null or $at == "" then null
  else (try (($at | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) - now | if . < 0 then 0 else . end | mss(.)) catch null) end;
def conf: [ $conf | split("\n")[]
            | select(test("^\\s*(#|$)") | not)
            | capture("^\\s*(?<k>[^=\\s]+)\\s*=\\s*(?<v>.*?)\\s*$")? ]
          | map({(.k): .v}) | add // {};
def statename:
  if .conn != "ok" then (if .conn == "auth" then "auth" else "offline" end)
  elif .card != null then (if .card.revealed then "back" else "front" end)
  elif .counts == null then "loading"
  elif (.next_due_at // null) != null then "waiting" else "done" end;
def flat($s):
  (.counts // {}) as $c | (.card // {}) as $k | ($k.previews // {}) as $p | (.last // {}) as $l
  | { state: $s, conn: .conn,
      new: ($c.new // 0), learning: ($c.learning // 0), review: ($c.review // 0),
      total: (($c.new // 0) + ($c.learning // 0) + ($c.review // 0)),
      due: (($c.new // 0) + ($c.learning // 0) + ($c.review // 0)),
      pending: (.pending // 0), day_ends_at: (.day_ends_at // ""), notice: (.notice // ""),
      last_rating: ($l.rating // ""), undoable: (($l.undoable // false) | tostring),
      card_id: ($k.id // ""), kind: ($k.kind // ""), front: ($k.front // ""),
      back: ($k.back // ""), reading: ($k.reading // ""), sentence: ($k.sentence // ""),
      revealed: (($k.revealed // false) | tostring),
      preview_again: ($p.again // ""), preview_hard: ($p.hard // ""),
      preview_good: ($p.good // ""), preview_easy: ($p.easy // "") }
    # Only when the card has a type label (older daemons omit it), so the flat JSON stays as before.
    + (if $k.kind_label then {kind_label: $k.kind_label, kind_badge: "[\($k.kind_label)] ", kind_prefix: "\($k.kind_label) · "} else {} end)
    # Only while waiting, so the flat JSON of every other state stays as before; a template
    # field that is absent reads as empty.
    # Likewise only while Keep going is available.
    + (if (.can_keep_going // false) then {can_keep_going: "true", keep_hint: " · click: keep going"} else {} end)
    + (if $s == "waiting" then {next_due_at: .next_due_at, next_due_in: (nextin(.next_due_at) // "")} else {} end);
def fill($f):
  gsub("\\{(?<k>[a-z_]+)(:(?<n>[0-9]+))?\\}";
       (($f[.k] // "") | tostring | gsub("\\s*\n\\s*"; " ")) as $v
       | if .n == null then $v
         elif ($v | length) > (.n | tonumber) then $v[0:((.n | tonumber) - 1)] + "…"
         else $v end);
def pick($w; $key; $s; $dflt): $w["\($key).\($s)"] // $w[$key] // $dflt;
def buttons($w; $s):
  [ $w | keys[] | capture("^button\\.(?<b>[^.]+)") .b ] | unique
  | map({(.): (pick($w; "button.\(.)"; $s; "none")
               | if . == "next" then
                   (if $s == "front" then "reveal" elif $s == "back" then "good" else "none" end)
                 else . end)})
  | add // {};
conf as $w | statename as $s | flat($s) as $f
| $f + { text: (pick($w; "text"; $s; "{new}/{learning}/{review}") | fill($f) | sub("\\s+$"; "")),
    tooltip: (pick($w; "tooltip"; $s; "") | fill($f) | sub("\\s+$"; "")),
    class: (pick($w; "class"; $s; "{state}") | fill($f)),
    alt: $s, state: $s, buttons: buttons($w; $s) }
| if $json then . else .text end
'

check_templates() {
  local conf=$1 name
  while IFS= read -r name; do
    [[ " ${FIELDS//$'\n'/ } " == *" $name "* ]] ||
      die "unknown template field {$name}; known: $(tr '\n' ' ' <<<"$FIELDS")"
  done < <(grep -v '^[[:space:]]*#' <<<"$conf" | grep -oE '\{[a-z_]+(:[0-9]+)?\}' |
    sed -E 's/^\{([a-z_]+).*/\1/' | sort -u)
}

# Mirror every raw state line into the cache so `next` and `click` stay pure bash.
cache_writer() {
  local line tmp="$CACHE.$BASHPID"
  mkdir -p -- "$RUNTIME_DIR"
  while IFS= read -r line; do
    printf '%s\n' "$line" >"$tmp" && mv -f -- "$tmp" "$CACHE"
  done
}

stream_die() {
  printf '{"text":"語 error","tooltip":"kby: %s","class":"error","alt":"error","state":"error"}\n' "$1"
  die "$1"
}

stream() {
  local widget="" mode=json filter=""
  while (($#)); do
    case $1 in
      --json) mode=json ;;
      --text) mode=text ;;
      --raw) mode=raw ;;
      --jq) mode=jq filter=${2:?--jq needs a filter}; shift ;;
      -*) die "unknown stream option $1" ;;
      *) widget=$1 ;;
    esac
    shift
  done
  # A widget shows stdout only, so report a missing tool there as well as on stderr.
  command -v "$KBY_CLI" >/dev/null || stream_die "'$KBY_CLI' not found (set KBY_CLI)"
  command -v jq >/dev/null || stream_die "jq not found"

  local conf
  conf=$(widget_conf "$widget")
  check_templates "$conf"

  "$KBY_CLI" watch --format json | tee >(cache_writer) | case $mode in
    raw) cat ;;
    jq) jq --unbuffered -c "$filter" ;;
    json) jq --unbuffered -c --arg conf "$conf" --argjson json true "$JQ_RENDER" ;;
    text) jq --unbuffered -r --arg conf "$conf" --argjson json false "$JQ_RENDER" ;;
  esac
}

# ---------------------------------------------------------------- main

main() {
  (($#)) || { stream; exit; }
  case $1 in
    help | -h | --help) usage ;;
    -f | --follow | stream | watch | --text | --json | --raw | --jq) [[ $1 == -* && $1 != -f && $1 != --follow ]] || shift; stream "$@" ;;
    serve) shift; (($# == 0)) || die "usage: kby serve"; serve ;;
    do) shift; do_action "$@" ;;
    click) shift; click "$@" ;;
    widget | widgets) shift; widget_cmd "$@" ;;
    fields) echo "$FIELDS" | tr ' ' '\n' | grep . ;;
    status) current_state_json ;;
    state) state_name "$(current_state_json)" ;;
    *)
      local words=() a
      for a in "$@"; do
        case $a in
          -r) words+=(reveal) ;; -1) words+=(again) ;; -2) words+=(hard) ;;
          -3) words+=(good) ;; -4) words+=(easy) ;; -u) words+=(undo) ;;
          -k | keep) words+=(keep_going) ;; -K | unkeep) words+=(stop_keep_going) ;;
          -s) words+=(skip) ;; -R) words+=(refresh) ;; -n) words+=(next) ;;
          -*) die "unknown flag $a (try: kby help)" ;;
          *) words+=("$a") ;;
        esac
      done
      send "${words[@]}"
      ;;
  esac
}

main "$@"
