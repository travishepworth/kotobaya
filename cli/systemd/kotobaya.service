# Install: cp kotobaya.service ~/.config/systemd/user/ && systemctl --user enable --now kotobaya
# Needs ~/.config/kotobaya/config.toml (url, token_file); systemd does not inherit the shell env.
[Unit]
Description=Kotobaya review daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/kotobaya daemon
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
