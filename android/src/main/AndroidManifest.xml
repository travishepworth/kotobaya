<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- T305a: AnkiDroid's API permission. Free to declare only while AnkiDroid (and the other
         flavor) is not installed; install fails with DUPLICATE_PERMISSION otherwise. -->
    <permission
        android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE"
        android:description="@string/ankiapi_permission_description"
        android:label="@string/ankiapi_permission_label"
        android:protectionLevel="dangerous" />
    <application
        android:name=".app.KotobayaApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.Kotobaya"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".intake.IntakeActivity"
            android:exported="true"
            android:label="@string/intake_label"
            android:theme="@style/Theme.Kotobaya">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kotobaya" android:host="add" />
                <data android:scheme="kotobaya" android:host="word" />
                <data android:scheme="kotobaya" android:host="struggle" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".notify.DueReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="kotobaya.android.notify.DUE_ALARM" />
            </intent-filter>
        </receiver>
        <!-- T305a: AnkiDroid's FlashCardsContract provider (Takoboto stand-in). -->
        <provider
            android:name=".ankiapi.provider.AnkiProvider"
            android:authorities="com.ichi2.anki.flashcards"
            android:exported="true"
            android:grantUriPermissions="true"
            android:readPermission="com.ichi2.anki.permission.READ_WRITE_DATABASE"
            android:writePermission="com.ichi2.anki.permission.READ_WRITE_DATABASE">
            <!-- AddContentApi reads this to pick the provider spec (2 = notes_v2 / csum duplicate checks). -->
            <meta-data
                android:name="com.ichi2.anki.provider.spec"
                android:value="2" />
        </provider>
        <receiver
            android:name=".widget.KotobayaWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <receiver
            android:name=".widget.hotword.HotWordWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hotword_info" />
        </receiver>
        <service
            android:name=".widget.ReviewTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_agenda"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".push.KotobayaPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".ankiconnect.AnkiConnectService"
            android:exported="false" />
    </application>
</manifest>
