-- C-29 (ADR-047): version 1 -> 2 adds the device table tts_audio (contracts/db/sqldelight Local.sq).
-- Derived data, never synced; the prefetch pass fills it. Keep this statement identical to Local.sq.
CREATE TABLE tts_audio (
  voice TEXT NOT NULL,
  text TEXT NOT NULL,
  blob_hash TEXT NOT NULL,
  duration_ms INTEGER NOT NULL,
  checked_at INTEGER NOT NULL,
  PRIMARY KEY (voice, text)
);
