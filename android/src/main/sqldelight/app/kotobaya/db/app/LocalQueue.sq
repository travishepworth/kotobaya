-- Android queue loader queries (T304a). Reads only; learning-data writes go through sync ops.
-- Every query is set-based (one pass per table); nothing is looked up per card.

-- The scheduler.* settings plus cards.reading_enabled (ADR-035, SCHEMA.md 6.4) and cards.kanji_exemptions (ADR-042): everything QueueSettings reads.
schedulerSettings:
SELECT key, value FROM settings WHERE key LIKE 'scheduler.%' OR key = 'cards.reading_enabled' OR key = 'cards.kanji_exemptions';

-- Live cards of live notes that can be queued today. A refused cache (SYNC.md 9.4) is never a candidate.
-- ADR-040 / ADR-043: every started card (past NEW) of a vocab or kanji note is passed whatever its due date, and even
-- when suspended (as the server loader), because the builder reads
-- "introduced" (a vocab note with a card past NEW, for backfill) and "started" (a kanji with a card past NEW) from the
-- candidates; a not-yet-due card is never served by the builder.
queueCandidates:
SELECT c.id, c.note_id, c.kind, n.note_type_id, n.type, n.created_at, c.state, c.due_at, c.suspended,
       c.buried_until, ws.override_status, n.kanji_literal, n.entry_seq,
       CASE WHEN n.type = 'vocab' THEN n.fields ELSE '{}' END AS fields
FROM card c
JOIN note n ON n.id = c.note_id
LEFT JOIN word_status ws ON ws.entry_seq = n.entry_seq
WHERE c.deleted_at IS NULL AND c.merged_into_id IS NULL AND n.deleted_at IS NULL
  AND ((c.suspended = 0 AND (c.state = 'new' OR c.due_at < :dayEnd)) OR (c.state <> 'new' AND n.type IN ('vocab', 'kanji')))
  AND c.last_review_id IS NOT :refusedId;

-- ADR-040 (contracts/core README "C-27"): the literal of every kanji note that blocks minting: a live one, or one the
-- user deleted (deleted, not a merge loser: never re-created). Merge losers do not block.
kanjiNoteLiterals:
SELECT kanji_literal
FROM note
WHERE kanji_literal IS NOT NULL AND type = 'kanji' AND merged_into_id IS NULL;

liveDecks:
SELECT id, priority, enabled, new_cards_per_day, reviews_per_day, settings, type
FROM deck WHERE deleted_at IS NULL ORDER BY priority, id;

noteTypeTemplates:
SELECT id, templates FROM note_type;

-- deck_item memberships of non-smart live decks: e:<seq> items match the live vocab note of the entry,
-- n:<id> items follow merged_into_id (SYNC.md 8.5).
deckItemMemberships:
SELECT di.deck_id, di.position, di.item_key, n.id AS note_id
FROM deck_item di
JOIN deck d ON d.id = di.deck_id AND d.deleted_at IS NULL AND d.type <> 'smart'
JOIN note n ON n.entry_seq = di.entry_seq AND n.deleted_at IS NULL
WHERE di.deleted_at IS NULL AND di.entry_seq IS NOT NULL
UNION ALL
SELECT di.deck_id, di.position, di.item_key, n.id AS note_id
FROM deck_item di
JOIN deck d ON d.id = di.deck_id AND d.deleted_at IS NULL AND d.type <> 'smart'
JOIN note src ON src.id = di.note_id
JOIN note n ON n.id = COALESCE(src.merged_into_id, src.id)
WHERE di.deleted_at IS NULL AND di.note_id IS NOT NULL AND n.deleted_at IS NULL;

-- Today's non-undone answers; introduced_new = a learning row whose card had no earlier schedule-feeding row,
-- or whose last one was a reset. Cards resolve through merged_into_id.
-- (AND-POSTSYNC: a previous row with manual_action NULL must not make introduced_new NULL; the generated non-null
-- mapper threw on every load after an ordinary second learning answer today.)
-- AND-PERF: the previous row is looked up per member card through review_log_replay_idx (card_id, reviewed_at, ...):
-- members are the resolved card itself (if not merged away) and the cards merged into it. INDEXED BY pins the plan;
-- without it Android's SQLite walked review_log_reviewed_idx backwards over the whole history for every row of today
-- (minutes per call on 78k rows, all four pool connections busy). No row values, no COALESCE join on the lookup.
-- The index is defined in contracts/db Learning.sq; if it is ever dropped or renamed this query throws (guarded by
-- LoadGateTest.theReplayIndexTodayReviewsPinsExistsWithItsColumns).
-- The subquery yields the previous row's manual_action ('' when NULL), NULL when there is none; it runs only for
-- learning rows. Same result set as the pre-AND-PERF query (TodayReviewsQueryTest).
todayReviews:
SELECT sc.id AS card_id, sc.note_id AS note_id, r.review_type AS review_type,
       CASE WHEN r.review_type = 'learning' THEN
         COALESCE((SELECT COALESCE(p.manual_action, '') FROM review_log p INDEXED BY review_log_replay_idx
                   WHERE p.card_id IN (SELECT pc.id FROM card pc WHERE pc.id = sc.id AND pc.merged_into_id IS NULL
                                       UNION ALL
                                       SELECT pm.id FROM card pm WHERE pm.merged_into_id = sc.id)
                     AND p.reviewed_at <= r.reviewed_at
                     AND (p.reviewed_at < r.reviewed_at OR p.hlc < r.hlc OR (p.hlc = r.hlc AND p.id < r.id))
                     AND p.undone_at IS NULL AND p.review_type IN ('scheduled', 'learning', 'manual')
                   ORDER BY p.reviewed_at DESC, p.hlc DESC, p.id DESC LIMIT 1), 'reset') = 'reset'
       ELSE 0 END AS introduced_new,
       r.reviewed_at AS reviewed_at
FROM review_log r
JOIN card c ON c.id = r.card_id
JOIN card sc ON sc.id = COALESCE(c.merged_into_id, c.id)
WHERE r.undone_at IS NULL AND r.review_type IN ('scheduled', 'learning', 'drill', 'cram')
  AND r.reviewed_at >= :dayStart AND r.reviewed_at <= :now;

-- Earliest instant a started, queueable card becomes due after now (a buried card: when the bury ends). Retired cards
-- (ADR-035: vocab reading cards while :readingEnabled = 0) never count: the waiting screen must not wait for them.
nextDueAfter:
SELECT MIN(CASE WHEN c.buried_until IS NOT NULL AND c.buried_until > c.due_at THEN c.buried_until ELSE c.due_at END)
FROM card c
JOIN note n ON n.id = c.note_id
LEFT JOIN word_status ws ON ws.entry_seq = n.entry_seq
WHERE c.deleted_at IS NULL AND c.merged_into_id IS NULL AND n.deleted_at IS NULL AND c.suspended = 0
  AND c.state <> 'new' AND c.due_at IS NOT NULL
  AND c.last_review_id IS NOT :refusedId
  AND (ws.override_status IS NULL OR ws.override_status = 'known')
  AND (c.kind <> 'reading' OR n.type <> 'vocab' OR :readingEnabled = 1)
  AND (CASE WHEN c.buried_until IS NOT NULL AND c.buried_until > c.due_at THEN c.buried_until ELSE c.due_at END) > :now;

-- Hour buckets of started, queueable cards due before :horizon; overdue cards fall in bucket 0. Like nextDueAfter,
-- retired cards (ADR-035: vocab reading cards while :readingEnabled = 0) are left out: the builder never serves them.
forecastBuckets:
SELECT CASE WHEN due < :now THEN 0 ELSE (due - :now) / 3600000 END AS bucket, COUNT(*) AS n
FROM (
  SELECT CASE WHEN c.buried_until IS NOT NULL AND c.buried_until > c.due_at THEN c.buried_until ELSE c.due_at END AS due
  FROM card c
  JOIN note n ON n.id = c.note_id
  LEFT JOIN word_status ws ON ws.entry_seq = n.entry_seq
  WHERE c.deleted_at IS NULL AND c.merged_into_id IS NULL AND n.deleted_at IS NULL AND c.suspended = 0
    AND c.state <> 'new' AND c.due_at IS NOT NULL
    AND c.last_review_id IS NOT :refusedId
    AND (ws.override_status IS NULL OR ws.override_status = 'known')
    AND (c.kind <> 'reading' OR n.type <> 'vocab' OR :readingEnabled = 1)
)
WHERE due < :horizon
GROUP BY bucket;

-- AND-KEEPGOING-FIX, C-27 (contracts/core/README.md "C-27: pending entries and materialization"): pending entries of
-- one deck in (position, item_key) order: live e:<seq> items whose entry has no live note and no user-deleted note
-- (deleted, not a merge loser: deleting a deck word's note drops it for good), minus the overrides the builder never
-- introduces. The loader pages through them, keeping entries the installed dictionary has, up to its per-deck bound.
pendingDeckEntries:
SELECT di.entry_seq, di.position, di.item_key, ws.override_status
FROM deck_item di
LEFT JOIN word_status ws ON ws.entry_seq = di.entry_seq
WHERE di.deck_id = :deckId AND di.deleted_at IS NULL AND di.entry_seq IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM note n WHERE n.entry_seq = di.entry_seq AND (n.deleted_at IS NULL OR n.merged_into_id IS NULL))
  AND (ws.override_status IS NULL OR ws.override_status NOT IN ('known', 'never_forget', 'blacklisted', 'ignored'))
ORDER BY di.position, di.item_key
LIMIT :limit OFFSET :offset;
