-- LF-A3: the replica reads of the three local stats operations (getStatsSummary, getStatsHeatmap, getStatsRetention),
-- the server's StatsQueries over SQLite. Reads only; times are epoch ms (UTC); study days are computed in Kotlin.
-- No window functions (minSdk 26 ships SQLite 3.18): `introduced` is a correlated lookup of the previous row.

-- Non-undone, non-manual reviews with reviewed_at in [:lo, :hi) (a window wider than the requested study days).
-- introduced (scheduled / learning rows only): the row is the first schedule-feeding row of its card's replay root
-- (the card, or its merge survivor, with every card merged into that root), or the row before it is a manual reset;
-- replay order (reviewed_at, hlc, id). Drill and cram rows are never introduced.
-- PERF-LF: the previous row is looked up per member card through review_log_replay_idx (card_id, reviewed_at, ...), as
-- LocalQueue.sq todayReviews (AND-PERF): without INDEXED BY SQLite walked review_log_reviewed_idx (a MULTI-INDEX OR over
-- `reviewed_at <` / `=`) for every row of the window: seconds for a year of history. `p.reviewed_at <= r.reviewed_at` is
-- implied by the order condition and only lets the index bound the range. Same result set.
statsDayRows:
SELECT r.reviewed_at, r.utc_offset_min, r.review_type, r.rating, COALESCE(r.duration_ms, 0) AS duration_ms,
       CASE WHEN r.review_type IN ('scheduled', 'learning') THEN
         COALESCE((SELECT COALESCE(p.manual_action, '') FROM review_log p INDEXED BY review_log_replay_idx
                   WHERE p.card_id IN (SELECT pc.id FROM card pc WHERE pc.id = COALESCE(c.merged_into_id, c.id) AND pc.merged_into_id IS NULL
                                       UNION ALL
                                       SELECT pm.id FROM card pm WHERE pm.merged_into_id = COALESCE(c.merged_into_id, c.id))
                     AND p.reviewed_at <= r.reviewed_at
                     AND p.undone_at IS NULL AND p.review_type IN ('scheduled', 'learning', 'manual')
                     AND (p.reviewed_at < r.reviewed_at OR (p.reviewed_at = r.reviewed_at AND (p.hlc < r.hlc OR (p.hlc = r.hlc AND p.id < r.id))))
                   ORDER BY p.reviewed_at DESC, p.hlc DESC, p.id DESC LIMIT 1), 'reset') = 'reset'
       ELSE 0 END AS introduced
FROM review_log r
JOIN card c ON c.id = r.card_id
WHERE r.undone_at IS NULL AND r.review_type <> 'manual' AND r.reviewed_at >= :lo AND r.reviewed_at < :hi;

-- Streak input: non-undone, non-manual reviews, newest first (read through a cursor; the caller stops at the first gap).
statsStreakRows:
SELECT reviewed_at, utc_offset_min FROM review_log
WHERE undone_at IS NULL AND review_type <> 'manual'
ORDER BY reviewed_at DESC;

-- StatsSummary.totals: live notes; live cards of live notes, of those suspended and leeches (lapses >= :leech).
statsTotals:
SELECT (SELECT COUNT(*) FROM note WHERE deleted_at IS NULL) AS notes,
       COUNT(*) AS cards,
       COUNT(CASE WHEN c.suspended = 1 THEN 1 END) AS suspended,
       COUNT(CASE WHEN c.lapses >= :leech THEN 1 END) AS leeches
FROM card c
JOIN note n ON n.id = c.note_id
WHERE c.deleted_at IS NULL AND c.merged_into_id IS NULL AND n.deleted_at IS NULL;

-- StatsSummary.next_due_at: the earliest due_at after :now among live unsuspended cards of live notes; ADR-035: a
-- retired card (vocab reading while :readingEnabled = 0) is never next.
statsNextDue:
SELECT MIN(c.due_at) AS next_due FROM card c
JOIN note n ON n.id = c.note_id
WHERE c.deleted_at IS NULL AND c.merged_into_id IS NULL AND n.deleted_at IS NULL AND c.suspended = 0
  AND c.due_at > :now
  AND (c.kind <> 'reading' OR n.type <> 'vocab' OR :readingEnabled = 1);

-- Replay roots (the card, or its merge survivor) with a non-undone scheduled review in [:lo, :hi).
statsScheduledRoots:
SELECT DISTINCT COALESCE(c.merged_into_id, c.id) AS root
FROM review_log r
JOIN card c ON c.id = r.card_id
WHERE r.undone_at IS NULL AND r.review_type = 'scheduled' AND r.reviewed_at >= :lo AND r.reviewed_at < :hi
ORDER BY root;

-- PERF-LF: the per-root history cache of the stats (StatsHistoryCache). A replay root is a card not merged away, or a
-- merge survivor; its members are the root itself (while not merged away) and every card merged into it, exactly the
-- member set of statsDayRows' `introduced` lookup and of the replay.

-- Every card's kind, preset and note type (the retention group key `type/kind` and the preset of a root).
statsCardInfo:
SELECT c.id, c.kind, c.preset_id, n.type
FROM card c
JOIN note n ON n.id = c.note_id;

-- statsCardInfo of some cards.
statsCardInfoOf:
SELECT c.id, c.kind, c.preset_id, n.type
FROM card c
JOIN note n ON n.id = c.note_id
WHERE c.id IN :ids;

-- Every non-undone review_log row with its replay root (grouped in Kotlin).
statsReplayRows:
SELECT COALESCE(c.merged_into_id, c.id) AS root, r.id, r.hlc, r.reviewed_at, r.utc_offset_min, r.review_type, r.rating,
       r.manual_action, r.manual_due_at, r.import_source, COALESCE(r.duration_ms, 0) AS duration_ms
FROM review_log r
JOIN card c ON c.id = r.card_id
WHERE r.undone_at IS NULL;

-- statsReplayRows of some roots (pass the same ids twice): the rows of the roots themselves and of the cards merged into them.
statsReplayRowsOf:
SELECT COALESCE(c.merged_into_id, c.id) AS root, r.id, r.hlc, r.reviewed_at, r.utc_offset_min, r.review_type, r.rating,
       r.manual_action, r.manual_due_at, r.import_source, COALESCE(r.duration_ms, 0) AS duration_ms
FROM card c
JOIN review_log r ON r.card_id = c.id
WHERE ((c.id IN :roots AND c.merged_into_id IS NULL) OR c.merged_into_id IN :survivors) AND r.undone_at IS NULL;

-- The replay roots of some review_log rows.
statsRootsOfReviews:
SELECT DISTINCT COALESCE(c.merged_into_id, c.id) AS root
FROM review_log r
JOIN card c ON c.id = r.card_id
WHERE r.id IN :ids;

-- Some cards with the survivor they are merged into (both roots may have changed).
statsCardMergeOf:
SELECT id, merged_into_id FROM card WHERE id IN :ids;
