	"color": {
		"bg": { "light": "paper-50", "dark": "sumi-950", "use": "Page canvas behind everything." },
		"surface": { "light": "white", "dark": "sumi-900", "use": "Cards, panels, list containers, the review card." },
		"surface-sunken": { "light": "paper-100", "dark": "sumi-990", "use": "Wells: inputs at rest, code, mnemonic boxes, table header." },
		"surface-raised": { "light": "white", "dark": "sumi-850", "use": "Menus, sheets, dialogs, toasts (with elevation)." },
		"surface-hover": { "light": "paper-100", "dark": "sumi-800", "use": "Hover / pressed wash on rows and quiet buttons." },
		"surface-selected": { "light": "ai-50", "dark": "ai-900", "use": "Selected row, current nav item." },
		"border": { "light": "paper-200", "dark": "sumi-750", "use": "Hairlines and dividers (decorative: never the only edge of a control)." },
		"border-strong": { "light": "stone-500", "dark": "sumi-400", "use": "Edges of inputs, checkboxes, outlined controls (3:1 non-text)." },

		"text": { "light": "ink", "dark": "sumi-50", "use": "Body and headings." },
		"text-muted": { "light": "stone-600", "dark": "sumi-200", "use": "Secondary text, readings, metadata, placeholders." },
		"text-disabled": { "light": "paper-300", "dark": "sumi-700", "use": "Disabled labels (exempt from contrast; always paired with a disabled cursor/state)." },

		"primary": { "light": "ai-700", "dark": "ai-200", "use": "The one action colour: primary buttons, active tab underline, progress." },
		"on-primary": { "light": "white", "dark": "ai-950", "use": "Text and icons on primary." },
		"primary-hover": { "light": "ai-800", "dark": "ai-100", "use": "Hover/pressed primary." },
		"primary-container": { "light": "ai-50", "dark": "ai-850", "use": "Tonal buttons, info banners, selected chips." },
		"on-primary-container": { "light": "ai-800", "dark": "ai-100", "use": "Text on primary-container." },
		"link": { "light": "ai-600", "dark": "ai-300", "use": "Inline links (always underlined in body text)." },
		"focus": { "light": "ai-500", "dark": "ai-300", "use": "Focus ring (2px, offset 2px)." },
		"brand": { "light": "shu-600", "dark": "shu-300", "use": "The vermilion seal: wordmark, today marker, cloze. Never a button colour." },

		"danger": { "light": "shu-700", "dark": "shu-300", "use": "Destructive buttons, error text." },
		"on-danger": { "light": "white", "dark": "shu-900", "use": "Text on danger." },
		"danger-container": { "light": "shu-50", "dark": "shu-850", "use": "Error banners, error toasts, invalid field wash." },
		"on-danger-container": { "light": "shu-700", "dark": "shu-100", "use": "Text on danger-container." },
		"warning-container": { "light": "kohaku-50", "dark": "kohaku-850", "use": "Warning banners (e.g. offline, 900 due)." },
		"on-warning-container": { "light": "kohaku-700", "dark": "kohaku-100", "use": "Text on warning-container." },
		"success-container": { "light": "matcha-50", "dark": "matcha-850", "use": "Success toasts, 'synced' banners." },
		"on-success-container": { "light": "matcha-700", "dark": "matcha-100", "use": "Text on success-container." },
		"scrim": { "light": "#1E1C1966", "dark": "#000000A3", "use": "Behind dialogs and sheets." },

		"grade-again": { "light": "shu-700", "dark": "shu-300", "use": "Again: label, key hint, top rule of the button." },
		"grade-again-container": { "light": "shu-50", "dark": "shu-850", "use": "Again button fill." },
		"grade-hard": { "light": "kohaku-700", "dark": "kohaku-300", "use": "Hard." },
		"grade-hard-container": { "light": "kohaku-50", "dark": "kohaku-850", "use": "Hard button fill." },
		"grade-good": { "light": "matcha-700", "dark": "matcha-300", "use": "Good (the default action)." },
		"grade-good-container": { "light": "matcha-50", "dark": "matcha-850", "use": "Good button fill." },
		"grade-easy": { "light": "sora-700", "dark": "sora-300", "use": "Easy." },
		"grade-easy-container": { "light": "sora-50", "dark": "sora-850", "use": "Easy button fill." },

		"state-new": { "light": "ai-700", "dark": "ai-200", "use": "Card state: new." },
		"state-new-container": { "light": "ai-50", "dark": "ai-850", "use": "" },
		"state-learning": { "light": "kohaku-700", "dark": "kohaku-200", "use": "Card state: learning." },
		"state-learning-container": { "light": "kohaku-50", "dark": "kohaku-850", "use": "" },
		"state-review": { "light": "matcha-700", "dark": "matcha-200", "use": "Card state: review." },
		"state-review-container": { "light": "matcha-50", "dark": "matcha-850", "use": "" },
		"state-relearning": { "light": "shu-700", "dark": "shu-200", "use": "Card state: relearning." },
		"state-relearning-container": { "light": "shu-50", "dark": "shu-850", "use": "" },
		"state-suspended": { "light": "stone-600", "dark": "sumi-200", "use": "Card state: suspended (with a pause glyph)." },
		"state-suspended-container": { "light": "paper-100", "dark": "sumi-800", "use": "" },
		"state-leech": { "light": "fuji-600", "dark": "fuji-300", "use": "Leech marker (with a flag glyph)." },
		"state-leech-container": { "light": "fuji-50", "dark": "fuji-850", "use": "" },

		"pitch-line": { "light": "ai-600", "dark": "ai-300", "use": "The pitch contour drawn over morae on cards." },
		"pitch-heiban": { "light": "sora-600", "dark": "sora-300", "use": "平板 pattern label (always with the pattern name or [0])." },
		"pitch-atamadaka": { "light": "shu-600", "dark": "shu-300", "use": "頭高 [1]." },
		"pitch-nakadaka": { "light": "kohaku-600", "dark": "kohaku-300", "use": "中高 [n]." },
		"pitch-odaka": { "light": "matcha-600", "dark": "matcha-300", "use": "尾高 [n = morae]." },

		"highlight": { "light": "kohaku-100", "dark": "kohaku-850", "use": "Spot highlight on cards, search hits." },
		"on-highlight": { "light": "ink", "dark": "kohaku-100", "use": "Text on highlight." },

		"deck-ai": { "light": "ai-600", "dark": "ai-300", "use": "Deck colour: indigo (dot, icon, label)." },
		"deck-ai-container": { "light": "ai-50", "dark": "ai-850", "use": "" },
		"deck-shu": { "light": "shu-600", "dark": "shu-300", "use": "Deck colour: vermilion." },
		"deck-shu-container": { "light": "shu-50", "dark": "shu-850", "use": "" },
		"deck-matcha": { "light": "matcha-600", "dark": "matcha-300", "use": "Deck colour: green." },
		"deck-matcha-container": { "light": "matcha-50", "dark": "matcha-850", "use": "" },
		"deck-kohaku": { "light": "kohaku-600", "dark": "kohaku-300", "use": "Deck colour: amber." },
		"deck-kohaku-container": { "light": "kohaku-50", "dark": "kohaku-850", "use": "" },
		"deck-fuji": { "light": "fuji-600", "dark": "fuji-300", "use": "Deck colour: wisteria." },
		"deck-fuji-container": { "light": "fuji-50", "dark": "fuji-850", "use": "" },
		"deck-sora": { "light": "sora-600", "dark": "sora-300", "use": "Deck colour: sky." },
		"deck-sora-container": { "light": "sora-50", "dark": "sora-850", "use": "" },
		"deck-sakura": { "light": "sakura-600", "dark": "sakura-300", "use": "Deck colour: cherry." },
		"deck-sakura-container": { "light": "sakura-50", "dark": "sakura-850", "use": "" },
		"deck-aoi": { "light": "aoi-600", "dark": "aoi-300", "use": "Deck colour: teal." },
		"deck-aoi-container": { "light": "aoi-50", "dark": "aoi-850", "use": "" },
		"deck-hai": { "light": "stone-600", "dark": "sumi-200", "use": "Deck colour: ash (the default)." },
		"deck-hai-container": { "light": "paper-100", "dark": "sumi-800", "use": "" }
	},
	"contrast": [
		{ "kind": "text", "min": 4.5, "fg": ["text", "text-muted"], "bg": ["bg", "surface", "surface-sunken", "surface-raised", "surface-hover", "surface-selected"] },
		{ "kind": "text", "min": 4.5, "fg": ["primary", "link"], "bg": ["bg", "surface", "surface-raised", "surface-hover"] },
		{ "kind": "text", "min": 4.5, "fg": ["on-primary"], "bg": ["primary", "primary-hover"] },
		{ "kind": "text", "min": 4.5, "fg": ["on-primary-container"], "bg": ["primary-container"] },
		{ "kind": "text", "min": 4.5, "fg": ["brand", "danger"], "bg": ["bg", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["on-danger"], "bg": ["danger"] },
		{ "kind": "text", "min": 4.5, "fg": ["on-danger-container"], "bg": ["danger-container"] },
		{ "kind": "text", "min": 4.5, "fg": ["on-warning-container"], "bg": ["warning-container"] },
		{ "kind": "text", "min": 4.5, "fg": ["on-success-container"], "bg": ["success-container"] },
		{ "kind": "text", "min": 4.5, "fg": ["text"], "bg": ["danger-container", "warning-container", "success-container", "primary-container"] },
		{ "kind": "text", "min": 4.5, "fg": ["grade-again"], "bg": ["grade-again-container", "surface", "bg"] },
		{ "kind": "text", "min": 4.5, "fg": ["grade-hard"], "bg": ["grade-hard-container", "surface", "bg"] },
		{ "kind": "text", "min": 4.5, "fg": ["grade-good"], "bg": ["grade-good-container", "surface", "bg"] },
		{ "kind": "text", "min": 4.5, "fg": ["grade-easy"], "bg": ["grade-easy-container", "surface", "bg"] },
		{ "kind": "text", "min": 4.5, "fg": ["text"], "bg": ["grade-again-container", "grade-hard-container", "grade-good-container", "grade-easy-container"] },
		{ "kind": "text", "min": 4.5, "fg": ["state-new"], "bg": ["state-new-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["state-learning"], "bg": ["state-learning-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["state-review"], "bg": ["state-review-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["state-relearning"], "bg": ["state-relearning-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["state-suspended"], "bg": ["state-suspended-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["state-leech"], "bg": ["state-leech-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["pitch-heiban", "pitch-atamadaka", "pitch-nakadaka", "pitch-odaka"], "bg": ["surface", "bg"] },
		{ "kind": "text", "min": 4.5, "fg": ["on-highlight"], "bg": ["highlight"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-ai"], "bg": ["deck-ai-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-shu"], "bg": ["deck-shu-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-matcha"], "bg": ["deck-matcha-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-kohaku"], "bg": ["deck-kohaku-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-fuji"], "bg": ["deck-fuji-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-sora"], "bg": ["deck-sora-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-sakura"], "bg": ["deck-sakura-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-aoi"], "bg": ["deck-aoi-container", "surface"] },
		{ "kind": "text", "min": 4.5, "fg": ["deck-hai"], "bg": ["deck-hai-container", "surface"] },
		{ "kind": "non-text", "min": 3, "fg": ["border-strong", "focus", "primary", "pitch-line"], "bg": ["bg", "surface", "surface-sunken", "surface-raised"] },
		{ "kind": "non-text", "min": 3, "fg": ["danger"], "bg": ["surface-sunken", "danger-container"] }
	],
	"card": {
		"$about": "assets/card/card.css variables (--kb-card-*): the card stylesheet also runs alone in the Android WebView.",
		"color": {
			"fg": "text",
			"fg-muted": "text-muted",
			"bg": "surface",
			"accent": "brand",
			"highlight": "highlight",
			"on-highlight": "on-highlight",
			"divider": "border",
			"control": "border-strong",
			"pitch-line": "pitch-line",
			"mnemonic-bg": "surface-sunken",
			"link": "link"
		},
		"size": {
			"base": { "min": 1.1875, "max": 1.3125 },
			"expression": { "min": 2.25, "max": 3.5 },
			"literal": { "min": 4, "max": 6.5 },
			"sentence": { "min": 1.3125, "max": 1.625 },
			"reading": { "min": 1.125, "max": 1.375 }
		},
		"leading": 1.7,
		"ruby-scale": 0.5
	},
	"type": {
		"$about": "Web sizes are rem and grow fluidly from fluidFromPx to fluidToPx viewport width; Android uses sp (scales with the system font size). lh = unitless line-height.",
		"fluidFromPx": 360,
		"fluidToPx": 1280,
		"roles": {
			"jp-hero": { "min": 4.5, "max": 7, "sp": 80, "lh": 1.1, "weight": 400, "family": "serif", "tracking": 0, "use": "Kanji literal on kanji cards and the kanji page." },
			"jp-display": { "min": 2.25, "max": 3.5, "sp": 40, "lh": 1.3, "weight": 500, "family": "sans", "tracking": 0, "use": "Review headword, dictionary headword." },
			"display": { "min": 2, "max": 2.75, "sp": 32, "lh": 1.2, "weight": 600, "family": "sans", "tracking": -0.01, "use": "Big numbers: due count, streak, stats headline figures (tabular numerals)." },
			"headline": { "min": 1.5, "max": 1.875, "sp": 26, "lh": 1.3, "weight": 600, "family": "sans", "tracking": -0.005, "use": "Page titles." },
			"title": { "min": 1.1875, "max": 1.375, "sp": 20, "lh": 1.4, "weight": 600, "family": "sans", "tracking": 0, "use": "Section and card titles, dialog titles." },
			"title-sm": { "min": 1.0625, "max": 1.0625, "sp": 17, "lh": 1.45, "weight": 600, "family": "sans", "tracking": 0, "use": "List-row primary line, table headings of panels." },
			"jp-body": { "min": 1.0625, "max": 1.1875, "sp": 18, "lh": 1.9, "weight": 400, "family": "sans", "tracking": 0.02, "use": "Japanese running text: example sentences, reader. Airy for kana." },
			"reading": { "min": 1.0625, "max": 1.25, "sp": 18, "lh": 1.6, "weight": 400, "family": "sans", "tracking": 0.04, "use": "Kana readings under a headword." },
			"body-lg": { "min": 1.0625, "max": 1.125, "sp": 17, "lh": 1.7, "weight": 400, "family": "sans", "tracking": 0, "use": "Glosses on the review back and the dictionary entry." },
			"body": { "min": 1, "max": 1, "sp": 16, "lh": 1.65, "weight": 400, "family": "sans", "tracking": 0, "use": "Default UI text." },
			"body-sm": { "min": 0.875, "max": 0.875, "sp": 14, "lh": 1.55, "weight": 400, "family": "sans", "tracking": 0, "use": "Secondary lines, table cells." },
			"label": { "min": 0.875, "max": 0.875, "sp": 14, "lh": 1.3, "weight": 500, "family": "sans", "tracking": 0.01, "use": "Buttons, tabs, chips, form labels." },
			"caption": { "min": 0.8125, "max": 0.8125, "sp": 12, "lh": 1.4, "weight": 400, "family": "sans", "tracking": 0.01, "use": "Metadata, key hints, interval previews. The smallest size in the app." },
			"overline": { "min": 0.75, "max": 0.75, "sp": 12, "lh": 1.4, "weight": 600, "family": "sans", "tracking": 0.08, "use": "Uppercase section eyebrows (Latin only; never on Japanese)." }
		},
		"ruby": { "scale": 0.5, "minRem": 0.625, "minSp": 10, "lineHeight": 2.2, "use": "Furigana: half the base size, never below 10 px/sp; text that carries ruby gets the taller line-height." },
		"material3": {
			"displayLarge": "jp-hero",
			"displayMedium": "jp-display",
			"displaySmall": "display",
			"headlineLarge": "display",
			"headlineMedium": "headline",
			"headlineSmall": "title",
			"titleLarge": "title",
			"titleMedium": "title-sm",
			"titleSmall": "label",
			"bodyLarge": "body-lg",
			"bodyMedium": "body",
			"bodySmall": "body-sm",
			"labelLarge": "label",
			"labelMedium": "caption",
			"labelSmall": "overline"
		}
	},
	"space": { "0": 0, "0-5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
	"radius": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "full": 9999 },
	"elevation": {
		"0": { "dp": 0, "light": "none", "dark": "none" },
		"1": { "dp": 1, "light": "0 1px 2px rgb(30 28 25 / 0.06), 0 1px 3px rgb(30 28 25 / 0.05)", "dark": "0 1px 2px rgb(0 0 0 / 0.4)" },
		"2": { "dp": 3, "light": "0 2px 6px rgb(30 28 25 / 0.07), 0 6px 16px rgb(30 28 25 / 0.06)", "dark": "0 2px 6px rgb(0 0 0 / 0.45), 0 6px 16px rgb(0 0 0 / 0.3)" },
		"3": { "dp": 6, "light": "0 8px 24px rgb(30 28 25 / 0.12), 0 2px 6px rgb(30 28 25 / 0.06)", "dark": "0 8px 24px rgb(0 0 0 / 0.55), 0 2px 6px rgb(0 0 0 / 0.35)" }
	},
	"motion": {
		"duration": { "instant": 80, "fast": 140, "base": 200, "slow": 240 },
		"easing": {
			"standard": [0.2, 0, 0, 1],
			"decelerate": [0, 0, 0, 1],
			"accelerate": [0.3, 0, 1, 1],
			"emphasized": [0.05, 0.7, 0.1, 1]
		},
		"distance": { "sm": 4, "md": 8, "lg": 16 },
		"$about": "Every duration stays under 250 ms. Under reduced motion, distances become 0 (fades only)."
