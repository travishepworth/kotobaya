-- Device-only tables: they have no server counterpart and are never synced.
-- Contract: contracts/db/SCHEMA.md section 5.3. Type mapping as in Learning.sq.

-- Outbox of ops created on this device. An op is written here in the SAME
-- transaction as its local effect, so a crash can never lose or half-apply it.
CREATE TABLE pending_op (
  op_id TEXT NOT NULL PRIMARY KEY,    -- UUIDv7; becomes change.op_id on the server
  op_type TEXT NOT NULL,              -- e.g. review.logged
  op_version INTEGER NOT NULL DEFAULT 1,
  entity_type TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  hlc TEXT NOT NULL,                  -- push order is ascending hlc
  payload TEXT NOT NULL,              -- JSON object
  created_at INTEGER NOT NULL,
  -- pending: not yet accepted. acked: server accepted (or reported duplicate). rejected: server refused permanently.
  -- acked rows may be deleted only once acked_seq <= pull_seq AND acked_seq <= durable_seq
  -- (SYNC.md 5.4); a log reset turns them back into pending (SYNC.md 6.2).
  -- rejected rows MUST be surfaced to the user, are never purged automatically, and leave that
  -- state only by a user action of SYNC.md 10.2: Retry (-> pending), Discard (delete + set
  -- rebuild_pending, then rebuild 10.3) or Re-mint (clock codes, 10.4). SYNC.md wins over this comment.
  state TEXT NOT NULL DEFAULT 'pending' CHECK (state IN ('pending', 'acked', 'rejected')),
  attempts INTEGER NOT NULL DEFAULT 0,
  last_error TEXT,
  acked_seq INTEGER                   -- change.seq the server assigned, once acked
);

CREATE INDEX pending_op_state_idx ON pending_op (state, hlc);

-- Small key/value store for sync bookkeeping. Keys used by the contract:
--   device_id        this device's uuid (set at pairing)
--   pull_seq         highest change.seq fully applied locally (decimal string; "0" before first pull)
--   hlc_last         last HLC issued or observed (for clock monotonicity)
--   last_sync_at     epoch ms of the last successful push+pull
--   dict_release_id  ref.dict_release.id of the installed dictionary file
--   core_scheduler_version  core scheduler version the card caches were last fully replayed with
--                    (opaque string reported by the core, compared by equality). Absent or
--                    different from the running core's => full replay of every
--                    card cache before anything is folded, then store the core's value. Kept by the
--                    rebuild. Meaning: contracts/sync/SYNC.md 10.5.
-- Further keys, defined in contracts/sync/SYNC.md 10.5 (authoritative):
--   rebuild_pending  "1" while a rebuild (SYNC.md 10.3) is in progress
--   log_epoch        server log_epoch that pull_seq / acked_seq belong to
--   durable_seq      latest durable_seq of that epoch (decimal; absent = "0")
--   hlc_acked        greatest hlc of this device's acknowledged ops
--   remint_offset    server_time - pt of the first clock rejection (signed decimal ms)
CREATE TABLE sync_state (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

-- Which blobs this device wants or has. The bytes live in app-private storage
-- under a path derived from the hash.
CREATE TABLE blob_cache (
  hash TEXT NOT NULL PRIMARY KEY,     -- sha256 hex, = app.blob.hash
  size_bytes INTEGER,                 -- NULL until known
  content_type TEXT,
  -- wanted: should be downloaded (prefetch). cached: bytes present. missing: server returned 404.
  state TEXT NOT NULL DEFAULT 'wanted' CHECK (state IN ('wanted', 'cached', 'missing')),
  reason TEXT NOT NULL DEFAULT 'card',-- 'card' | 'media' | 'cover' : storage-budget breakdown
  requested_at INTEGER NOT NULL,
  last_used_at INTEGER
);

CREATE INDEX blob_cache_state_idx ON blob_cache (state, requested_at);

-- C-29 (ADR-047): the (voice, text) -> audio blob pairs this device has resolved with the server
-- (API resolveSpeech). A device-local copy of rows of the server system table app.tts_audio:
-- derived data, never synced, never written by an op, safe to delete entirely (the next prefetch
-- pass refills it). The local getReviewQueue reads it to fill QueueItem.word_audio.blob_hash.
-- Contract: contracts/db/SCHEMA.md 5.3 and 6.6.
CREATE TABLE tts_audio (
  voice TEXT NOT NULL,                -- VOICEVOX style id, decimal digits, e.g. '3'
  text TEXT NOT NULL,                 -- exact speech text, e.g. 'たべる' (byte-for-byte key)
  blob_hash TEXT NOT NULL,            -- sha256 hex of the audio; the bytes are tracked in blob_cache
  duration_ms INTEGER NOT NULL,
  checked_at INTEGER NOT NULL,        -- epoch ms of the resolveSpeech answer this row came from
  PRIMARY KEY (voice, text)
);

-- C-31 (ADR-050): answers of the API operations of class `cached` (contracts/api/shell/ops.json),
-- kept so that the shell can answer them at once and revalidate in the background
-- (contracts/api/shell/SHELL.md 4.4, rules K-1 .. K-4). Device-local and NOT learning data:
-- never synced, never written by an op, no pending_op row; deleting every row is always safe
-- (the next request is `503 shell_uncached` and refills it). Deleted entirely by unpairShell and
-- by pairing with another server; a rebuild or log reset sets stale = 1 on every row.
-- Contract: contracts/db/SCHEMA.md 5.3.
CREATE TABLE response_cache (
  -- operationId || char(10) || path || char(10) || canonical query (SHELL.md rule K-1), e.g.
  -- 'listSentences' || char(10) || '/api/v1/sentences' || char(10) || 'cursor=&limit=20'
  key TEXT NOT NULL PRIMARY KEY,
  op TEXT NOT NULL,                   -- operationId, e.g. 'getDeckCoverage' (invalidation is per operation)
  path TEXT NOT NULL,                 -- req.path as received, e.g. '/api/v1/decks/<id>/coverage'
  query TEXT NOT NULL,                -- canonical query, '' for none
  status INTEGER NOT NULL CHECK (status BETWEEN 200 AND 299),  -- only 2xx answers are stored
  content_type TEXT NOT NULL,         -- as the server sent it, e.g. 'application/json'
  body TEXT NOT NULL,                 -- exact response text
  size_bytes INTEGER NOT NULL CHECK (size_bytes BETWEEN 0 AND 4194304),  -- UTF-8 length of body; 16 MiB in total (K-4)
  etag TEXT,                          -- the server's ETag for If-None-Match, or NULL
  fetched_at INTEGER NOT NULL,        -- epoch ms, device clock: fetched or last confirmed unchanged (kotobaya-cached-at)
  last_used_at INTEGER NOT NULL,      -- epoch ms, device clock: last hit or store; eviction order (LRU)
  stale INTEGER NOT NULL DEFAULT 0 CHECK (stale IN (0, 1))  -- 1: a table this answer depends on changed since the fetch
);

CREATE INDEX response_cache_op_idx ON response_cache (op);
CREATE INDEX response_cache_lru_idx ON response_cache (last_used_at);
