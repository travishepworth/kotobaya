-- Learning data, on-device subset ("AppDatabase"). Contract: contracts/db/SCHEMA.md section 5.
--
-- Mirrors app.* in V1__init.sql. Type mapping (binding):
--   uuid        -> TEXT, canonical lowercase 8-4-4-4-12
--   timestamptz -> INTEGER, epoch milliseconds UTC
--   boolean     -> INTEGER 0/1
--   jsonb, arrays -> TEXT holding JSON (arrays as JSON arrays)
--   app.hlc     -> TEXT (SQLite's default BINARY collation is the required byte order)
-- Column meanings, register names and invariants are those of the Postgres
-- comments. Differences from the server are marked "DEVICE:".
-- Must stay within SQLite 3.18 (Android API 26): no generated columns, no UPSERT,
-- no JSON functions in DDL.

CREATE TABLE grammar_point (
  id TEXT NOT NULL PRIMARY KEY,
  language TEXT NOT NULL DEFAULT 'ja',
  title TEXT NOT NULL,
  pattern TEXT NOT NULL DEFAULT '',
  meaning TEXT NOT NULL DEFAULT '',
  explanation TEXT NOT NULL DEFAULT '',
  notes TEXT NOT NULL DEFAULT '',
  jlpt INTEGER,
  detection_rules TEXT NOT NULL DEFAULT '[]',
  related_ids TEXT NOT NULL DEFAULT '[]',
  links TEXT NOT NULL DEFAULT '[]',
  is_stub INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER,
  clocks TEXT NOT NULL DEFAULT '{}'
);

CREATE TABLE note_type (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  base_type TEXT NOT NULL CHECK (base_type IN ('vocab', 'kanji', 'phrase', 'grammar', 'sentence', 'custom')),
  builtin INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  fields TEXT NOT NULL,
  templates TEXT NOT NULL,
  css TEXT NOT NULL DEFAULT '',
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER,
  clocks TEXT NOT NULL DEFAULT '{}'
);

