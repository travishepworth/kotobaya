-- Reference dictionary, on-device build ("RefDatabase"). Contract: contracts/db/SCHEMA.md section 5.
--
-- This schema describes a SEPARATE SQLite file from the learning database. The
-- worker's dict-refresh job builds the file (one per release and scope) and the
-- phone downloads it and opens it read-only. The worker MUST create exactly
-- these tables and indexes and set PRAGMA user_version = 1.
--
-- Type mapping from ref.* in V1__init.sql:
--   boolean -> INTEGER 0/1; text[] / smallint[] / jsonb -> TEXT holding JSON;
--   everything else unchanged. Column meanings are identical to Postgres.
-- A device build may contain a subset of entries (top 60k + referenced); every
-- child row present refers to an entry that is present.

CREATE TABLE dict_release (
  id INTEGER NOT NULL PRIMARY KEY,
  version TEXT NOT NULL,
  built_at INTEGER NOT NULL,          -- epoch milliseconds, UTC
  scope TEXT NOT NULL,                -- 'top60k' | 'all'
  sources TEXT NOT NULL               -- JSON object, as ref.dict_release.sources
);

CREATE TABLE dict_entry (
  seq INTEGER NOT NULL PRIMARY KEY,
  language TEXT NOT NULL DEFAULT 'ja',
  headword TEXT NOT NULL,
  headword_reading TEXT NOT NULL,
  is_common INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  kanji_forms TEXT NOT NULL,          -- JSON array
  readings TEXT NOT NULL,             -- JSON array
  senses TEXT NOT NULL,               -- JSON array
  pos TEXT NOT NULL,                  -- JSON array of strings
  misc TEXT NOT NULL,                 -- JSON array of strings
  freq_rank INTEGER,
  retired INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0  -- ref.dict_entry.retired_release_id IS NOT NULL
);

CREATE INDEX dict_entry_freq_rank_idx ON dict_entry (freq_rank);

CREATE TABLE dict_entry_form (
  seq INTEGER NOT NULL REFERENCES dict_entry (seq),
  kind TEXT NOT NULL,                 -- 'kanji' | 'reading'
  ord INTEGER NOT NULL,
  form TEXT NOT NULL,
  norm TEXT NOT NULL,                 -- NFKC + katakana folded to hiragana
  common INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  PRIMARY KEY (seq, kind, ord)
);

-- Exact and prefix search: norm = ? / norm >= ? AND norm < ?. Substring search is a scan (LIKE).
CREATE INDEX dict_entry_form_norm_idx ON dict_entry_form (norm);

CREATE TABLE dict_entry_gloss (
  seq INTEGER NOT NULL REFERENCES dict_entry (seq),
  sense_ord INTEGER NOT NULL,
  gloss_ord INTEGER NOT NULL,
  lang TEXT NOT NULL DEFAULT 'eng',
  gloss TEXT NOT NULL,
  gloss_lower TEXT NOT NULL,          -- lowercase of gloss, for prefix search (device only)
  PRIMARY KEY (seq, sense_ord, gloss_ord)
);

CREATE INDEX dict_entry_gloss_lower_idx ON dict_entry_gloss (gloss_lower);

CREATE TABLE entry_kanji (
  seq INTEGER NOT NULL REFERENCES dict_entry (seq),
  literal TEXT NOT NULL,
  PRIMARY KEY (seq, literal)
);

CREATE INDEX entry_kanji_literal_idx ON entry_kanji (literal);

CREATE TABLE freq_list (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  priority INTEGER NOT NULL
);

CREATE TABLE entry_freq (
  seq INTEGER NOT NULL REFERENCES dict_entry (seq),
  list_id TEXT NOT NULL REFERENCES freq_list (id),
  rank INTEGER NOT NULL,
  PRIMARY KEY (seq, list_id)
);

CREATE TABLE entry_pitch (
  seq INTEGER NOT NULL REFERENCES dict_entry (seq),
  reading TEXT NOT NULL,
  positions TEXT NOT NULL,            -- JSON array of integers, e.g. [0,2]
  PRIMARY KEY (seq, reading)
);

CREATE TABLE kanji (
  literal TEXT NOT NULL PRIMARY KEY,
  on_readings TEXT NOT NULL,          -- JSON array of strings
  kun_readings TEXT NOT NULL,         -- JSON array of strings
  nanori TEXT NOT NULL,               -- JSON array of strings
  meanings TEXT NOT NULL,             -- JSON array of strings
  stroke_count INTEGER,
  grade INTEGER,
  jlpt INTEGER,
  freq_rank INTEGER,
  radical TEXT,
  components TEXT NOT NULL            -- JSON array of strings
);

CREATE TABLE example_sentence (
  id INTEGER NOT NULL PRIMARY KEY,
  language TEXT NOT NULL DEFAULT 'ja',
  text TEXT NOT NULL,
  translation TEXT NOT NULL,
  translation_id INTEGER
);

CREATE TABLE example_sentence_entry (
  sentence_id INTEGER NOT NULL REFERENCES example_sentence (id),
  seq INTEGER NOT NULL REFERENCES dict_entry (seq),
  PRIMARY KEY (sentence_id, seq)
);

CREATE INDEX example_sentence_entry_seq_idx ON example_sentence_entry (seq);
