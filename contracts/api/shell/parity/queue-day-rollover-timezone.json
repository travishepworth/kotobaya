{
  "id": "queue-day-rollover-timezone",
  "title": "The study day rolls over at day_rollover_hour in scheduler.timezone, not in UTC",
  "covers": [
    "queue.day_rollover_timezone"
  ],
  "narrative": [
    "scheduler.timezone is Asia/Tokyo (UTC+9, no DST), day_rollover_hour is the default 4: the study day changes at 19:00:00.000Z. new_per_day is 1; two cards are new.",
    "Step 0, 18:59:00Z (03:59 local, still the 20th): study_day 2026-11-20, one new card available.",
    "Step 1, 18:59:30Z: the first card is answered Easy (introduces it).",
    "Step 2, 18:59:59Z: the day's new-card limit is used up.",
    "Step 3, 19:00:00Z: study_day 2026-11-21; the limit is fresh, the second card is available.",
    "With UTC day boundaries steps 0-3 would all be study day 2026-11-20 ending 2026-11-21T04:00Z."
  ],
