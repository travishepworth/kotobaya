{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "note_type.updated",
  "description": "Sets a subset of a note type's registers, all at the op's hlc. OPS.md#note_typeupdated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "set"
  ],
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/uuid",
      "description": "Id of the note type. Equals the envelope's entity_id."
    },
    "set": {
      "type": "object",
      "description": "Registers to write. At least one.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "description": "Register 'name'.",
          "minLength": 1,
          "maxLength": 200
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "description": "Ordered field definitions; the whole array is ONE register ('fields'). Keys must be unique within the array (server rejects duplicates with invalid_value). Keys are never renamed.",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "kind"
            ],
            "description": "One field. Unknown keys are preserved.",
            "properties": {
              "key": {
                "$ref": "../common.schema.json#/$defs/key",
                "description": "Field key used in note.fields and {{placeholders}}."
              },
              "label": {
                "type": "string",
                "description": "Display label.",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "text",
                  "audio",
                  "image"
                ],
                "description": "What the field holds."
              }
            }
          }
        },
        "css": {
          "type": "string",
          "description": "Register 'css'."
        },
        "templates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "../common.schema.json#/$defs/key"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/template"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "One register 'templates.<kind>' per key present. null removes the kind from the object (the register keeps its clock)."
        }
      }
    }
  }
}
