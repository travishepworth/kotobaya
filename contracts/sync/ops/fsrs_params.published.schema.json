{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fsrs_params.published",
  "description": "The optimizer publishes new FSRS weights for a preset. Applied iff weights_version > the stored one. OPS.md#fsrs_paramspublished",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "weights_version",
    "fsrs_version",
    "weights",
    "optimized_at"
  ],
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/uuid",
      "description": "Id of the preset. Equals the envelope's entity_id."
    },
    "weights_version": {
      "type": "integer",
      "description": "New version, = previous + 1.",
      "minimum": 1
    },
    "fsrs_version": {
      "type": "string",
      "enum": [
        "6"
      ],
      "description": "FSRS algorithm version the weights belong to. Only '6' (FSRS-6) in op_version 1; a future FSRS version is added additively with its own per-index bounds."
    },
    "weights": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100.0,
          "description": "w[0]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100.0,
          "description": "w[1]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100.0,
          "description": "w[2]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100.0,
          "description": "w[3]"
        },
        {
          "type": "number",
          "minimum": 1.0,
          "maximum": 10.0,
          "description": "w[4]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 4.0,
          "description": "w[5]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 4.0,
          "description": "w[6]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.75,
          "description": "w[7]"
        },
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 4.5,
          "description": "w[8]"
        },
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 0.8,
          "description": "w[9]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 3.5,
          "description": "w[10]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 5.0,
          "description": "w[11]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.25,
          "description": "w[12]"
        },
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.9,
          "description": "w[13]"
        },
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 4.0,
          "description": "w[14]"
        },
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "w[15]"
        },
        {
          "type": "number",
          "minimum": 1.0,
          "maximum": 6.0,
          "description": "w[16]"
        },
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "description": "w[17]"
        },
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "description": "w[18]"
        },
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 0.8,
          "description": "w[19]"
        },
        {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.8,
          "description": "w[20]"
        }
      ],
      "items": false,
      "description": "The 21 FSRS-6 weights w[0]..w[20]. Each is bounded (inclusive) by py-fsrs 6.3.2's LOWER_BOUNDS_PARAMETERS / UPPER_BOUNDS_PARAMETERS; out-of-range weights are rejected (schema_invalid at push, C-1). The bounds give initial stability > 0 and decay w[20] >= 0.1; finite schedules follow together with the core's clamps (T006: STABILITY_MIN, difficulty in [1,10], maximum interval). w[20] is the decay."
    },
    "optimized_at": {
      "$ref": "../common.schema.json#/$defs/instant_ms",
      "description": "When the optimizer run finished."
    },
    "optimizer_stats": {
      "description": "Metrics of the run; unknown keys preserved. Default null.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "review_count": {
              "type": "integer"
            },
            "log_loss": {
              "type": "number"
            },
            "rmse_bins": {
              "type": "number"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
