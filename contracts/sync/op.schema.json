{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Op",
  "description": "One sync operation: the unit stored in pending_op (device) and change (server). SYNC.md section 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op_id",
    "op_type",
    "op_version",
    "entity_type",
    "entity_id",
    "device_id",
    "hlc",
    "payload"
  ],
  "properties": {
    "op_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "UUIDv7 minted with the op. The idempotency key: the server applies an op_id at most once."
    },
    "op_type": {
      "enum": [
        "note_type.created",
        "note_type.updated",
        "note_type.deleted",
        "note.created",
        "note.updated",
        "note.deleted",
        "note.merged",
        "card.created",
        "card.suspended",
        "card.unsuspended",
        "card.unburied",
        "card.deleted",
        "card.buried",
        "card.flag_set",
        "card.preset_set",
        "card.merged",
        "review.logged",
        "review.undone",
        "word.status_set",
        "word.status_cleared",
        "deck.created",
        "deck.updated",
        "deck.deleted",
        "deck.content_published",
        "deck.item_put",
        "deck.item_removed",
        "confusable.suggested",
        "confusable.confirmed",
        "confusable.rejected",
        "grammar.created",
        "grammar.updated",
        "grammar.deleted",
        "grammar.span_put",
        "grammar.span_removed",
        "settings.set",
        "fsrs_params.created",
        "fsrs_params.updated",
        "fsrs_params.deleted",
        "fsrs_params.published",
        "media.created",
        "media.updated",
        "media.deleted",
        "media.content_published",
        "parse_override.put",
        "parse_override.deleted"
      ],
      "description": "Dotted op name. The closed set of v1 op types."
    },
    "op_version": {
      "const": 1,
      "description": "Version of the payload schema for this op_type. Always 1 in this contract."
    },
    "entity_type": {
      "type": "string",
      "description": "Table the op targets, fixed per op_type (ops/index.json)."
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Primary key of the targeted row as text, derived from the payload as listed in ops/index.json (parts joined with '|')."
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Origin device = the device that minted hlc. Must equal the last 36 characters of hlc."
    },
    "hlc": {
      "$ref": "common.schema.json#/$defs/hlc",
      "description": "Clock of the op. Decides every last-writer-wins comparison and supplies the op's wall time (first 12 hex digits)."
    },
    "payload": {
      "type": "object",
      "description": "Op-specific body; schema chosen by op_type."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Server sequence number (change.seq). Present on every pulled op; MUST be absent on pushed ops."
    },
    "caused_by_op_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Pulled ops only: op_id of the op that made the server emit this one (merges, cascades), else null."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "op_type": {
            "const": "note_type.created"
          }
        },
        "required": [
          "op_type"
        ]
      },
      "then": {
        "properties": {
          "entity_type": {
            "const": "note_type"
          },
