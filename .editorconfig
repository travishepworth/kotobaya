root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md,css,svelte,ts,js,kts}]
indent_size = 2

[web/**.{ts,js,svelte,json,css,html}]
indent_style = tab

[Makefile]
indent_style = tab
